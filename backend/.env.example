# Copy to .env for local dev (never commit the real .env).
# In production these are set as real environment variables/secrets on
# whatever host you deploy to (Render/Fly/AWS/etc.) — not in a file.

# Flask environment: development | testing | production
FLASK_ENV=development

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional — defaults to SECRET_KEY if unset. Fine to leave blank.
JWT_SECRET_KEY=

# Postgres connection string in production, e.g.:
#   postgresql://user:password@host:5432/muster
# Left unset locally, this falls back to sqlite:///muster.db
DATABASE_URL=

# Comma-separated list of allowed origins for the mobile/web client, or "*"
# for dev. Lock this down before shipping.
CORS_ORIGINS=*

# Set to any non-empty value once a real transactional email provider
# (SES, SendGrid, Postmark, ...) is wired into muster/auth.py. Until then,
# password reset tokens are returned in the API response for dev/testing
# instead of emailed — see forgot_password() in muster/auth.py.
EMAIL_BACKEND=

PORT=5000
